# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. See config/models.yaml for which provider is
# active per role.

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5

# Filled in starting Project 2 (RAG) / Project 3 (Graph) chapters, not needed
# yet for Project 1.
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Filled in at Project 1's observability chapter (ch. 9 containerize /
# Part V observability chapters).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Filled in at ch. 30's API-key guardrail. Generate a real random value
# for any real deployment, never reuse this file's own empty placeholder.
API_KEY=
