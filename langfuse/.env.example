# Copy to .env, fill in real generated values, never commit .env itself
# (the root .gitignore's ".env" rule already covers this file too).
#
#   openssl rand -hex 32   # ENCRYPTION_KEY
#   openssl rand -hex 16   # SALT
#
# The pk-lf-.../sk-lf-... values are just labeled random strings for a
# throwaway local dev instance, not issued by anything, generate them
# yourself, e.g. `echo "pk-lf-$(openssl rand -hex 12)"`.

ENCRYPTION_KEY=
SALT=
NEXTAUTH_URL=http://localhost:3001

LANGFUSE_INIT_ORG_ID=reliable-agents
LANGFUSE_INIT_ORG_NAME=Reliable Agents Labs
LANGFUSE_INIT_PROJECT_ID=reorder-agent
LANGFUSE_INIT_PROJECT_NAME=Reorder Agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=dev@example.com
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=
